  schema:startDate "2022-10-01"^^xsd:date ;
  schema:maintainer dice:NikitSrivastava ;
  schema:homepage <https://arxiv.org/abs/2409.11272> ;
  schema:name "LOLA" ;
  schema:logo "lola_logo.png" ;
